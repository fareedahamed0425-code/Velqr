{
  "version": 2,
  "rewrites": [
    {
      "source": "/generate",
      "destination": "/api/index"
    },
    {
      "source": "/shorten_url",
      "destination": "/api/index"
    },
    {
      "source": "/velqr/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
